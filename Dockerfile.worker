FROM python:3.11-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Runs the Redis Streams consumer group -> audit_events table pipeline.
# Deliberately not launched from api/main.py's FastAPI process -- see
# worker/main.py module docstring for why.
CMD ["python", "-m", "worker.main"]
